# Optional: drive the catalogue from a Google Sheet so the shop owner can add or
# edit products without a developer. Leave it empty to use the catalogue that
# ships in src/data/products.json.
#
# Accepts either the full sheet link or just the sheet id, e.g.
#   CATALOG_SHEET_URL=https://docs.google.com/spreadsheets/d/1AbC.../edit
#   CATALOG_SHEET_URL=1AbC...
CATALOG_SHEET_URL=

# How often (seconds) the sheet is re-read. 300 = every 5 minutes.
CATALOG_REVALIDATE_SECONDS=300
