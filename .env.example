# ---- Supabase (required) ---------------------------------------------------
# Create a project at https://supabase.com, then copy these from
# Project Settings → API. Never commit real values — this file is a template.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role / secret key. Bypasses Row Level Security — server-side only.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Optional: Google Sheet catalogue --------------------------------------
# Leave empty to use the Supabase catalogue. Set it to import products from a
# sheet instead (see README).
CATALOG_SHEET_URL=
CATALOG_REVALIDATE_SECONDS=300
